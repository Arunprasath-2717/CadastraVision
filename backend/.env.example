# ─────────────────────────────────────────────────────────────────────────────
# CadastraVision Backend — Environment Configuration Template
# Copy this file to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (local dev):
DATABASE_URL=sqlite+aiosqlite:///./cadastravision.db

# PostgreSQL (staging / production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cadastravision

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
